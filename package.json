{
  "name": "@wufeng0105/dsh-teammate-model-picker",
  "version": "0.3.3",
  "type": "module",
  "description": "让你手动给队友（子智能体）换模型：队友卡在一个不能用的模型上（比如额度用完）时，换个还能用的模型就能接着干，不用删掉重建，也不影响你自己的会话和全局默认模型。",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wufeng0105/dsh-teammate-model-picker.git"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "deepseek",
    "cordis",
    "plugin",
    "bundle",
    "subagent",
    "agent-teams",
    "teammate",
    "model-switcher",
    "model-selection",
    "quota"
  ],
  "icon": "icon.svg",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "host",
    "vendor/*.mjs",
    "vendor/LICENSE-*",
    "tools",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE",
    "DESIGN.md",
    "CONTEXT.md",
    "CHANGELOG.md",
    "REPORT.md",
    "RELEASE.md"
  ],
  "engines": {
    "dsh": ">=0.2.1-rc.5 <0.3.0"
  },
  "scripts": {
    "check": "node scripts/check.mjs",
    "test": "node --test tests/**/*.test.mjs",
    "doctor": "node tools/doctor.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": []
    }
  }
}
