{
  "name": "@wufeng0105/dsh-teammate-model-picker",
  "version": "0.3.2",
  "type": "module",
  "description": "给 DSH 队友会话加一个模型选择器：队友额度用完时直接换个还有额度的模型让它继续跑，不用重建队友，也不影响你的会话和全局默认模型。",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wufeng0105/dsh-teammate-model-picker.git"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "deepseek",
    "cordis",
    "plugin",
    "bundle",
    "subagent",
    "agent-teams",
    "teammate",
    "model-switcher",
    "model-selection",
    "quota"
  ],
  "icon": "icon.svg",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "host",
    "vendor/*.mjs",
    "vendor/LICENSE-*",
    "tools",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE",
    "DESIGN.md",
    "CONTEXT.md",
    "CHANGELOG.md",
    "REPORT.md"
  ],
  "engines": {
    "dsh": ">=0.2.1-rc.5 <0.3.0"
  },
  "scripts": {
    "check": "node scripts/check.mjs",
    "test": "node --test tests/**/*.test.mjs",
    "doctor": "node tools/doctor.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": []
    }
  }
}
