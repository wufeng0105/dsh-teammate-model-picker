{
  "name": "@local/dsh-teammate-model-picker",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Give DSH teammate (continuable subagent) sessions their own model picker: switch a teammate to another available model without touching the Lead session or the global default model.",
  "icon": "icon.svg",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "host",
    "vendor/*.mjs",
    "vendor/LICENSE-*",
    "tools",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE",
    "DESIGN.md",
    "CONTEXT.md",
    "CHANGELOG.md",
    "REPORT.md"
  ],
  "engines": {
    "dsh": ">=0.2.1-rc.5 <0.3.0"
  },
  "scripts": {
    "check": "node scripts/check.mjs",
    "test": "node --test tests/",
    "doctor": "node tools/doctor.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": []
    }
  }
}
